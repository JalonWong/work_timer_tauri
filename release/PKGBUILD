# Maintainer: Jalon Wong <jalonwong@gmail.com>
pkgname=work_timer_tauri
pkgver=0.1.1
pkgrel=1
pkgdesc="A Work Timer Application"
arch=('x86_64')
url="https://github.com/you/myapp"
license=('MIT')

package() {
  install -Dm644 "${startdir}/../src-tauri/icons/icon.svg" \
    "${pkgdir}/usr/share/pixmaps/${pkgname}.svg"

  install -Dm755 "${startdir}/../src-tauri/target/release/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 "${startdir}/../src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_amd64/data/usr/share/applications/${pkgname}.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"
}
